APP_NAME=SodAI API
APP_ENV=development
API_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:3000
GUEST_COOKIE_SECURE=false
DATABASE_URL=postgresql+asyncpg://sodai_app:change-me@localhost:5432/sodai
REDIS_URL=redis://127.0.0.1:6379/0
SODAI_MODEL_ROOT=./var/models
INFERENCE_MODEL_ACTIVE_LIMIT=32
INFERENCE_GUEST_MODEL_ACTIVE_LIMIT=1

# OIDC-compatible JWT provider. Better Auth uses its base URL for both issuer
# and audience by default. These values can later point to Cognito or another IdP.
AUTH_ISSUER=http://localhost:3000
AUTH_AUDIENCE=http://localhost:3000
AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
AUTH_JWT_ALGORITHM=EdDSA
AUTH_JWT_LEEWAY_SECONDS=30
AUTH_JWKS_CACHE_SECONDS=3600
AUTH_JWKS_TIMEOUT_SECONDS=5
