APP_NAME=SodAI API
APP_ENV=production
API_PREFIX=/api/v1
FRONTEND_ORIGIN=https://app.sodai.me
GUEST_COOKIE_SECURE=true

DATABASE_URL=postgresql+asyncpg://sodai_app:change-me-app-database@postgres:5432/sodai
REDIS_URL=redis://redis:6379/0
SODAI_MODEL_ROOT=/models
INFERENCE_MODEL_ACTIVE_LIMIT=32
INFERENCE_GUEST_MODEL_ACTIVE_LIMIT=1
HUMAN_RECONCILIATION_INTERVAL_SECONDS=5

AUTH_ISSUER=https://app.sodai.me
AUTH_AUDIENCE=https://app.sodai.me
AUTH_JWKS_URL=http://auth:13201/api/auth/jwks
AUTH_JWT_ALGORITHM=EdDSA
AUTH_JWT_LEEWAY_SECONDS=30
AUTH_JWKS_CACHE_SECONDS=3600
AUTH_JWKS_TIMEOUT_SECONDS=5
