# Docker Compose production secrets. Copy to .env.production and replace every
# change-me value with a different random secret.
SODAI_PUBLIC_ORIGIN=https://app.sodai.me
SODAI_IMAGE_TAG=local
POSTGRES_DATA_VOLUME=sodai-production-postgres-data
REDIS_DATA_VOLUME=sodai-production-redis-data

POSTGRES_ADMIN_PASSWORD=change-me-postgres-admin
AUTH_DATABASE_PASSWORD=change-me-auth-database
APP_DATABASE_PASSWORD=change-me-app-database
REDIS_PASSWORD=change-me-redis

# Use the stable UUID from `nvidia-smi -L`, not a boot-dependent GPU index.
SODAI_INFERENCE_GPU_UUID=GPU-replace-with-nvidia-smi-uuid
HINA_DEVICE=cuda:0
HINA_ARTIFACT_ID=
HINA_RESOURCE_POOL=gpu-cuda:0
ASUKA1_DEVICE=cuda:0
ASUKA1_ARTIFACT_ID=
ASUKA1_RESOURCE_POOL=gpu-cuda:0
SODAI_MODEL_ROOT=/models
SODAI_MODEL_HOST_PATH=./var/models
INFERENCE_MODEL_ACTIVE_LIMIT=32
INFERENCE_GUEST_MODEL_ACTIVE_LIMIT=1

# Remotely-managed Cloudflare Tunnel for app.sodai.me.
CLOUDFLARE_TUNNEL_TOKEN=change-me-cloudflare-tunnel-token
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.7.1
