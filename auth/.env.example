AUTH_HOST=127.0.0.1
AUTH_PORT=3001

# Public origin. Keep this stable because it is also the JWT issuer and audience.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Dedicated sodai_auth role. The connection always uses auth,public as search_path.
AUTH_DATABASE_URL=postgresql://sodai_auth:change-me@localhost:5432/sodai
AUTH_DATABASE_POOL_SIZE=10

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Google OAuth is enabled only when both values are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: cf-connecting-ip or x-forwarded-for. Trust it only when a private
# gateway removes incoming copies and creates the value itself.
AUTH_TRUSTED_CLIENT_IP_HEADER=

# Local development writes OTP messages to this process's standard output.
AUTH_EMAIL_DELIVERY=console

# SMTP example
# AUTH_EMAIL_DELIVERY=smtp
# AUTH_EMAIL_FROM=SodAI <no-reply@sodai.me>
# AUTH_SMTP_HOST=127.0.0.1
# AUTH_SMTP_PORT=1025
# AUTH_SMTP_SECURE=false
# AUTH_SMTP_USER=
# AUTH_SMTP_PASSWORD=
