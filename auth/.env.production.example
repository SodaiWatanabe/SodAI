AUTH_HOST=0.0.0.0
AUTH_PORT=13201

# Canonical public origin. This is also the JWT issuer and audience.
BETTER_AUTH_URL=https://app.sodai.me
BETTER_AUTH_TRUSTED_ORIGINS=https://app.sodai.me

AUTH_DATABASE_URL=postgresql://sodai_auth:change-me-auth-database@postgres:5432/sodai
AUTH_DATABASE_POOL_SIZE=10
BETTER_AUTH_SECRET=change-me-with-at-least-32-random-characters

# Optional. Register https://app.sodai.me/api/auth/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Valid only when Cloudflare Tunnel is the exclusive public path.
AUTH_TRUSTED_CLIENT_IP_HEADER=cf-connecting-ip

AUTH_EMAIL_DELIVERY=smtp
AUTH_EMAIL_FROM=SodAI <no-reply@auth.sodai.me>
AUTH_SMTP_HOST=smtp.resend.com
AUTH_SMTP_PORT=465
AUTH_SMTP_SECURE=true
AUTH_SMTP_USER=resend
AUTH_SMTP_PASSWORD=change-me-smtp-password
