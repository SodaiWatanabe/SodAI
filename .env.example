# Docker Compose infrastructure
# Copy this file to .env and replace every change-me value with a random secret.

POSTGRES_ADMIN_PASSWORD=change-me-postgres-admin
AUTH_DATABASE_PASSWORD=change-me-auth-database
APP_DATABASE_PASSWORD=change-me-app-database
REDIS_PASSWORD=change-me-redis

# Development-only host bindings. The production compose file publishes no data ports.
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
HINA_DEVICE=cuda:0
# Optional: run a worker for a specific immutable artifact during a rolling deployment.
HINA_ARTIFACT_ID=
SODAI_MODEL_ROOT=./var/models
INFERENCE_MODEL_ACTIVE_LIMIT=32
INFERENCE_GUEST_MODEL_ACTIVE_LIMIT=1
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Optional Cloudflare Tunnel profile. Leave blank when the tunnel is not used.
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.7.1
