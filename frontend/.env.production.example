# Browser traffic stays on the canonical app origin. Cloudflare routes
# /api/v1/* to FastAPI and all other paths to Next.js.
NEXT_PUBLIC_API_BASE_URL=https://app.sodai.me

# Server-side service discovery stays on the private Compose network.
SODAI_API_BASE_URL=http://backend:13202
AUTH_SERVICE_URL=http://auth:13201
