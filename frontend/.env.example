# Public endpoints
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Optional internal FastAPI URL used only by the Next.js server.
SODAI_API_BASE_URL=http://localhost:8000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Authentication database (dedicated sodai_auth role, auth schema only)
AUTH_DATABASE_URL=postgresql://sodai_auth:change-me@localhost:5432/sodai
AUTH_DATABASE_POOL_SIZE=10

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Google OAuth (both values are optional together)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Set true only when the origin is reachable exclusively through Cloudflare.
AUTH_TRUST_CLOUDFLARE=false

# Development delivery. One-time login codes are written to the server log.
AUTH_EMAIL_DELIVERY=console

# Production SMTP example
# AUTH_EMAIL_DELIVERY=smtp
# AUTH_EMAIL_FROM=SodAI <no-reply@sodai.me>
# AUTH_SMTP_HOST=127.0.0.1
# AUTH_SMTP_PORT=1025
# AUTH_SMTP_SECURE=false
# AUTH_SMTP_USER=
# AUTH_SMTP_PASSWORD=
